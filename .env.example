# Copy to .env on the NAS and fill in your real values.
# .env is gitignored, so `git pull` will never overwrite it.

# TrueNAS dataset to mount at /app/data inside the container.
# Example: /mnt/SSDs/Databases/MTG-collection
MTG_DATA_PATH=/mnt/your-pool/mtg-data

# Long random secret - never commit the real value.
SECRET_KEY=change-me-to-something-random
